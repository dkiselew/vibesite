{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "webdocs-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	// Local `wrangler dev`. Production values live in env.production.
	"vars": {
		"WORKSPACE_SLUG": "demo",
		"HOST": "localhost:8787",
		"URL_SCHEME": "http",
		"APP_ORIGIN": "http://localhost:5173"
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "webdocs"
		},
		{
			"bucket_name": "webdocs",
			"binding": "webdocs",
			"remote": true
		}
	],
	"env": {
		"production": {
			"name": "webdocs-api",
			"main": "src/index.ts",
			"compatibility_date": "2026-09-23",
			"compatibility_flags": [
				"nodejs_compat"
			],
			"vars": {
				"WORKSPACE_SLUG": "demo",
				"HOST": "vibesite.online",
				"URL_SCHEME": "https",
				"APP_ORIGIN": "https://vibesite.online"
			},
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "webdocs"
				}
			],
			"observability": {
				"enabled": true,
				"logs": {
					"head_sampling_rate": 1
				},
				"traces": {
					"enabled": true,
					"head_sampling_rate": 1
				}
			}
		}
	}
}