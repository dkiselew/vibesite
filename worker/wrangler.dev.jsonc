{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webdocs-api",
  "main": "src/dev.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WORKSPACE_SLUG": "demo",
    "HOST": "localhost:8787",
    "URL_SCHEME": "http",
    "APP_ORIGIN": "http://localhost:5173"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "webdocs",
      "remote": true
    }
  ]
}
