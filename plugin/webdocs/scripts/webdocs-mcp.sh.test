#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fake="$tmp/curl"
log="$tmp/curl.log"
html="$tmp/page.html"
printf '%s' '<p>hello</p>' >"$html"

cat >"$fake" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >>"$WEBDOCS_CURL_LOG"
out=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "-o" ]; then
    out=$arg
  fi
  prev=$arg
done
method=GET
url=
for arg in "$@"; do
  if [ "$arg" = "-X" ]; then
    next_is_method=1
    continue
  fi
  if [ "${next_is_method:-}" = 1 ]; then
    method=$arg
    next_is_method=
    continue
  fi
  case "$arg" in
    http://*|https://*) url=$arg ;;
  esac
done
if [ "$method" = "PUT" ]; then
  printf '%s' '{"id":"11111111-1111-1111-1111-111111111111","name":"cv","url":"https://demo.vibesite.online/cv","created":true,"updated_at":"2026-09-24T00:00:00.000Z","bytes":12}' >"$out"
  printf '200'
  exit 0
fi
case "$url" in
  */api/documents)
    printf '%s' '{"documents":[{"id":"22222222-2222-2222-2222-222222222222","name":"cv","url":"https://pages.example.test/cv","updated_at":"2026-09-24T00:00:00.000Z","bytes":14}]}' >"$out"
    printf '200'
    exit 0
    ;;
  https://pages.example.test/cv)
    printf '%s' '<p>stored</p>' >"$out"
    printf '200'
    exit 0
    ;;
esac
printf '%s' '{"error":{"code":"bad_request","message":"unexpected"}}' >"$out"
printf '500'
exit 0
EOF
chmod +x "$fake" "$root/webdocs-mcp.sh"

{
  printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"test","version":"0"}}}'
  printf '%s\n' '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"put_document","arguments":{"name":"cv","path":"'"$html"'"}}}'
} >"$tmp/in"

MCP_KEY=secret WEBDOCS_API=https://api.example.test WEBDOCS_CURL="$fake" WEBDOCS_CURL_LOG="$log" WEBDOCS_CACHE_DIR="$tmp/cache" \
  "$root/webdocs-mcp.sh" <"$tmp/in" >"$tmp/out"

grep -q '"name":"webdocs"' "$tmp/out"
grep -q ' -X PUT ' "$log"
grep -q -- "--data-binary @$html" "$log"
grep -q '/api/documents/cv' "$log"
grep -q 'path' "$tmp/out"
test -f "$tmp/cache/11111111-1111-1111-1111-111111111111.html"
test ! -f "$html"

: >"$log"
printf '%s\n' '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"get_document","arguments":{"name":"cv"}}}' >"$tmp/in-get"
MCP_KEY=secret WEBDOCS_API=https://api.example.test WEBDOCS_CURL="$fake" WEBDOCS_CURL_LOG="$log" WEBDOCS_CACHE_DIR="$tmp/cache-get" \
  "$root/webdocs-mcp.sh" <"$tmp/in-get" >"$tmp/out-get"
grep -q '22222222-2222-2222-2222-222222222222.html' "$tmp/out-get"
if grep -q '<p>stored</p>' "$tmp/out-get"; then
  echo "get_document returned HTML" >&2
  exit 1
fi
test "$(cat "$tmp/cache-get/22222222-2222-2222-2222-222222222222.html")" = '<p>stored</p>'

printf '%s' '<p>local</p>' >"$tmp/cache-get/22222222-2222-2222-2222-222222222222.html"
: >"$log"
MCP_KEY=secret WEBDOCS_API=https://api.example.test WEBDOCS_CURL="$fake" WEBDOCS_CURL_LOG="$log" WEBDOCS_CACHE_DIR="$tmp/cache-get" \
  "$root/webdocs-mcp.sh" <"$tmp/in-get" >"$tmp/out-get-again"
test "$(cat "$tmp/cache-get/22222222-2222-2222-2222-222222222222.html")" = '<p>local</p>'
if grep -q 'pages.example.test/cv' "$log"; then
  echo "get_document downloaded over a local cache file" >&2
  exit 1
fi

echo "webdocs-mcp.sh ok"
